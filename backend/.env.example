# Copy this file to .env and fill in real values before running

PORT=4000 # port for the backend server to listen on

DB_HOST= # database host (e.g. localhost or an IP address)
DB_PORT=3306
DB_USER= # db user with read/write access to the database
DB_PASSWORD= # password for the db user
DB_NAME= # name of the database to use

# Long random string used to sign login session tokens (JWT). Generate your own.
JWT_SECRET=change_this_to_a_long_random_string

# Comma separated list of origins allowed to call this API (frontend URLs)
# Add both localhost and your machine's LAN IP once you know it, e.g.:
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.50:5173
CORS_ORIGINS=http://localhost:5173
